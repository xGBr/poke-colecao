# Copie este arquivo para ".env" (que já está no .gitignore) e preencha.

# Porta em que o servidor Node vai escutar
PORT=3000

# Ambiente: "production" ativa o cookie "secure" (exige HTTPS na frente,
# ex. via Caddy, Nginx ou Cloudflare Tunnel). Em "development" fica desligado
# para você conseguir testar em http://localhost sem certificado.
NODE_ENV=development

# Segredo usado para assinar o cookie de sessão do admin.
# Gere um valor aleatório com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio-longo

# Opcional: chave de API da pokemontcg.io / Scrydex para limites mais altos
# de requisição na busca de preços. Sem chave, funciona igual, só com um
# limite diário mais baixo.
POKEMONTCG_API_KEY=

# Opcional: URL do webhook do n8n para receber notificações em tempo real
# (Telegram, planilha, etc.) toda vez que alguém preencher o formulário de
# contato ou clicar em "Tenho essa carta!".
CONTACT_WEBHOOK_URL=
